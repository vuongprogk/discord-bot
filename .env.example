# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# OpenTelemetry Configuration
OTEL_ENDPOINT=http://otel-collector.provision.svc.cluster.local:4317

# PostgreSQL Database Configuration (Prisma format)
DATABASE_URL="postgresql://discord:your_password@your_host:5432/your_database?schema=public"
